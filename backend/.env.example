# ── HTTP (외부 접속: 사내 인트라넷 LAN 서비스) ──
UCS_DEBUG=false
# 0.0.0.0 = 모든 인터페이스 바인딩(LAN 접속 허용). 특정 NIC 로 제한하려면 그 IP 지정.
UCS_HOST=0.0.0.0
UCS_PORT=8099

# ── 정적 프론트엔드 통합 서빙 (단일 포트) ──
UCS_SERVE_FRONTEND=true
# 기본은 프로젝트 frontend/ 자동 탐지. 필요 시 절대경로 지정.
# UCS_FRONTEND_DIR=/opt/unique-code-system/frontend

# ── SQLite 단일 SSOT ──
# backend/data/ 하위 파일명. 외부 서비스(Redis 등) 불필요.
UCS_DB_FILE=ucs.sqlite3
